# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env
.env.production
.env*.bak*

# drizzle migrations output
drizzle/

# playwright
/test-results
/playwright-report
/playwright/.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP configuration with secrets
.mcp.json
.mcp_config.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# dashboard HTML output (generated)
tools/dashboard/out/

# Python bytecode
__pycache__/
*.py[cod]

# Izin Claude Code khusus mesin ini (berisi path absolut + nama MCP lokal).
# settings.json TETAP ikut repo; yang .local jangan.
.claude/settings.local.json

# Screenshot mentah tutorial: bahan sementara sebelum dianotasi annotate.py.
# Yang ikut repo hanya hasil anotasi di docs/tutorial/*/img/.
docs/tutorial/*/raw/
