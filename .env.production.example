# DB KLIEN (produksi) — jangan pernah dipakai untuk percobaan fitur.
# Salin jadi .env.production dan isi dari project Supabase yang SEKARANG
# (ref aixpakizbxegokrnhhlc — yang sudah berisi data klien).
#
# Keempat nilai di bawah SATU PASANGAN. Jangan menukar separuh dari project lain:
# URL dari project A + key dari project B = auth gagal dengan pesan yang membingungkan.
#
# Cek sebelum dipakai:  npm run db:whoami:prod

NODE_ENV=production
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=
